<mxCell id="c53" value="De VM's weten niets van VLAN's: het VLAN-nummer stel je in bij de netwerkinstellingen van de VM, en de bridge plakt zelf de tag erop. De host stuurt zonder tag, dat is het native VLAN 10." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#93C5FD;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="675" width="860" height="34" as="geometry"/></mxCell>
<mxCell id="c54" value="DHCP: de FortiGate deelt adressen uit in VLAN 30, 40 en 50. Clients in VLAN 30 krijgen de Windows Server als DNS-server. VLAN 10 en 20 hebben vaste IP's." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#93C5FD;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="860" height="34" as="geometry"/></mxCell>
